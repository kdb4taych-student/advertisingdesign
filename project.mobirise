        "main": true,
        "title": "Home - Designer & Barista",
        "meta_descr": "A creative dialogue between design and coffee. This page explores how designers and baristas share the same pursuit — precision, emotion, and the art of crafting meaningful experiences.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
